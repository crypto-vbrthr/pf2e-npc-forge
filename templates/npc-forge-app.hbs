<div class="npc-forge-shell">
  <form data-npc-forge-request class="npc-forge-controls">
    <div class="npc-forge-controls-scroll">
    <header class="npc-forge-panel-header">
      <h2>{{localize "NPCFORGE.App.CreateHeading"}}</h2>
      <p>{{localize "NPCFORGE.App.CreateText"}}</p>
    </header>

    <details class="npc-forge-section" open>
      <summary>{{localize "NPCFORGE.Sections.Basics"}}</summary>
      <div class="npc-forge-section-body npc-forge-form-grid">
        <label>{{localize "NPCFORGE.Fields.Level"}}<input type="number" name="level" value="{{request.level}}" min="-1" max="24"></label>
        <label>{{localize "NPCFORGE.Fields.Ancestry"}}
          <select name="ancestry">{{#each ancestryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}</select>
        </label>
        <label>{{localize "NPCFORGE.Fields.ClassProfile"}}
          <select name="classProfile">{{#each classOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}</select>
        </label>
        {{#if hasSpecializations}}
        <label>{{localize "NPCFORGE.Fields.ClassSpecialization"}}
          <select name="classSpecialization">
            <option value="">{{localize "NPCFORGE.Fields.Automatic"}}</option>
            {{#each specializationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        {{/if}}
        <label>{{localize "NPCFORGE.Fields.ProfessionCategory"}}
          <select name="professionCategory">
            {{#each professionCategoryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        <label>{{localize "NPCFORGE.Fields.Profession"}}
          <select name="profession">
            <option value="">{{localize "NPCFORGE.Fields.AutomaticWithinCategory"}}</option>
            {{#each professionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        {{#if hasProfessionSpecializations}}
        <label>{{localize "NPCFORGE.Fields.ProfessionSpecialization"}}
          <select name="professionSpecialization">
            <option value="">{{localize "NPCFORGE.Fields.Automatic"}}</option>
            {{#each professionSpecializationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        {{/if}}
      </div>
    </details>

    <details class="npc-forge-section" open>
      <summary>{{localize "NPCFORGE.Sections.Identity"}}</summary>
      <div class="npc-forge-section-body npc-forge-form-grid">
        <label>{{localize "NPCFORGE.Fields.Name"}}<input type="text" name="identityName" value="{{request.identity.name}}" placeholder="{{localize "NPCFORGE.Fields.Automatic"}}"></label>
        <label>{{localize "NPCFORGE.Fields.NamePack"}}
          <select name="identityNamePack">
            <option value="">{{localize "NPCFORGE.Fields.Automatic"}}</option>
            {{#each namePackOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        <label>{{localize "NPCFORGE.Fields.Gender"}}
          <select name="identityGender">{{#each genderOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
        <label>{{localize "NPCFORGE.Fields.Age"}}
          <select name="identityAgeCategory">{{#each ageOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
      </div>
    </details>
    <details class="npc-forge-section">
      <summary>{{localize "NPCFORGE.Sections.Equipment"}}</summary>
      <div class="npc-forge-section-body"><p class="npc-forge-muted">{{localize "NPCFORGE.App.EquipmentGeneratedText"}}</p></div>
    </details>

    </div>
    <div class="npc-forge-actions npc-forge-action-bar"><button type="button" data-action="generate"><i class="fa-solid fa-dice"></i> {{localize "NPCFORGE.Controls.Generate"}}</button></div>
  </form>

  <section class="npc-forge-preview">
    <div class="npc-forge-preview-scroll npc-forge-creature-preview">
    {{#if hasPreview}}
      <article class="npc-forge-sheet-card npc-forge-sheet-header">
        <div class="npc-forge-sheet-title">
          <h1>{{view.name}}</h1>
          <p>{{view.identityLine}}</p>
        </div>
        <div class="npc-forge-sheet-level">{{localize "NPCFORGE.Fields.Level"}} {{view.level}}</div>
      </article>


      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Identity"}}</h2>
        <div class="npc-forge-stat-grid npc-forge-stat-grid-defense">
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Fields.Gender"}}</span><strong>{{view.identity.gender}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Fields.Age"}}</span><strong>{{view.identity.ageYears}} · {{view.identity.ageCategory}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Fields.Size"}}</span><strong>{{view.identity.size}}</strong></div>
          <div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Fields.Languages"}}</span><strong>{{#each view.identity.languages}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</strong></div>
          {{#if view.identity.senses.length}}<div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Fields.Senses"}}</span><strong>{{#each view.identity.senses}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</strong></div>{{/if}}
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Attributes"}}</h2>
        <div class="npc-forge-stat-grid npc-forge-stat-grid-attributes">
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.STR"}}</span><strong>{{view.statistics.attributes.str}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.DEX"}}</span><strong>{{view.statistics.attributes.dex}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.CON"}}</span><strong>{{view.statistics.attributes.con}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.INT"}}</span><strong>{{view.statistics.attributes.int}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.WIS"}}</span><strong>{{view.statistics.attributes.wis}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.CHA"}}</span><strong>{{view.statistics.attributes.cha}}</strong></div>
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Defenses"}}</h2>
        <div class="npc-forge-stat-grid npc-forge-stat-grid-defense">
          <div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Stats.AC"}}</span><strong>{{view.statistics.ac}}</strong></div>
          <div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Stats.HP"}}</span><strong>{{view.statistics.hp}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Stats.Perception"}}</span><strong>{{view.statistics.perception}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Stats.Fortitude"}}</span><strong>{{view.statistics.saves.fortitude}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Stats.Reflex"}}</span><strong>{{view.statistics.saves.reflex}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Stats.Will"}}</span><strong>{{view.statistics.saves.will}}</strong></div>
          <div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Stats.Speed"}}</span><strong>{{view.statistics.speed}} {{localize "NPCFORGE.Units.Feet"}}</strong></div>
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Fields.Skills"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-sheet-list-grid">
          {{#each view.skills}}
            <div class="npc-forge-sheet-list-row"><span>{{displayName}}</span><strong>{{displayModifier}}</strong></div>
          {{/each}}
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Fields.Abilities"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-ability-list">
          {{#each view.abilities}}
            <article class="npc-forge-sheet-entry npc-forge-ability">
              <header><strong>{{displayName}}</strong><span class="npc-forge-ability-action">{{displayAction}}</span></header>
              <p>{{displayDescription}}</p>
            </article>
          {{/each}}
          {{#unless view.abilities.length}}<div class="npc-forge-muted">{{localize "NPCFORGE.App.NoAbilities"}}</div>{{/unless}}
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Equipment"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-inventory-list">
          {{#each view.inventory}}
            <div class="npc-forge-sheet-list-row"><span>{{displayName}}</span><span class="npc-forge-muted">{{displayType}}{{#if quantity}} · ×{{quantity}}{{/if}}</span></div>
          {{/each}}
          {{#unless view.inventory.length}}<div class="npc-forge-muted">{{localize "NPCFORGE.App.NoEquipment"}}</div>{{/unless}}
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Fields.Attacks"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-attack-list">
          {{#each view.attacks}}
            <article class="npc-forge-sheet-entry npc-forge-attack">
              <header><strong>{{displayName}}</strong><strong>{{displayModifier}}</strong></header>
              <p>{{displayDamage}} {{displayDamageType}}</p>
            </article>
          {{/each}}
        </div>
      </section>

    {{else}}
      <div class="npc-forge-empty">{{localize "NPCFORGE.App.NoPreview"}}</div>
    {{/if}}
    </div>
    {{#if hasPreview}}<div class="npc-forge-preview-actions npc-forge-action-bar"><button type="button" data-action="createActor"><i class="fa-solid fa-user-plus"></i> {{localize "NPCFORGE.Controls.CreateActor"}}</button></div>{{/if}}
  </section>
</div>
