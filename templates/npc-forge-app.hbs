<div class="npc-forge-shell">
  <form data-npc-forge-request class="npc-forge-controls">
    <header class="npc-forge-panel-header">
      <h2>{{localize "NPCFORGE.App.CreateHeading"}}</h2>
      <p>{{localize "NPCFORGE.App.CreateText"}}</p>
    </header>

    <details class="npc-forge-section" open>
      <summary>{{localize "NPCFORGE.Sections.Basics"}}</summary>
      <div class="npc-forge-section-body npc-forge-form-grid">
        <label>{{localize "NPCFORGE.Fields.Level"}}<input type="number" name="level" value="{{request.level}}" min="-1" max="24"></label>
        <label>{{localize "NPCFORGE.Fields.Ancestry"}}
          <select name="ancestry">{{#each ancestryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
        <label>{{localize "NPCFORGE.Fields.ClassProfile"}}
          <select name="classProfile">{{#each classOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
        <label>{{localize "NPCFORGE.Fields.Profession"}}
          <select name="profession">{{#each professionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
      </div>
    </details>

    <details class="npc-forge-section">
      <summary>{{localize "NPCFORGE.Sections.Identity"}}</summary>
      <div class="npc-forge-section-body npc-forge-coming-soon">{{localize "NPCFORGE.App.IdentityComingSoon"}}</div>
    </details>
    <details class="npc-forge-section">
      <summary>{{localize "NPCFORGE.Sections.Equipment"}}</summary>
      <div class="npc-forge-section-body npc-forge-coming-soon">{{localize "NPCFORGE.App.EquipmentComingSoon"}}</div>
    </details>

    <div class="npc-forge-actions"><button type="button" data-action="generate"><i class="fa-solid fa-dice"></i> {{localize "NPCFORGE.Controls.Generate"}}</button></div>
  </form>

  <section class="npc-forge-preview">
    {{#if hasPreview}}
      <article class="npc-forge-card npc-forge-identity-card">
        <div>
          <h2>{{view.name}}</h2>
          <p>{{view.identityLine}} · {{localize "NPCFORGE.Fields.Level"}} {{view.level}}</p>
        </div>
      </article>

      <details class="npc-forge-card" open>
        <summary>{{localize "NPCFORGE.Sections.CoreStatistics"}}</summary>
        <div class="npc-forge-card-body">
          <div class="npc-forge-metric-grid">
            <div><span>{{localize "NPCFORGE.Stats.AC"}}</span><strong>{{view.statistics.ac}}</strong></div>
            <div><span>{{localize "NPCFORGE.Stats.HP"}}</span><strong>{{view.statistics.hp}}</strong></div>
            <div><span>{{localize "NPCFORGE.Stats.Perception"}}</span><strong>{{view.statistics.perception}}</strong></div>
            <div><span>{{localize "NPCFORGE.Stats.Speed"}}</span><strong>{{view.statistics.speed}} {{localize "NPCFORGE.Units.Feet"}}</strong></div>
          </div>
          <div class="npc-forge-subheading">{{localize "NPCFORGE.Stats.Saves"}}</div>
          <div class="npc-forge-compact-grid three">
            <div><span>{{localize "NPCFORGE.Stats.Fortitude"}}</span><strong>{{view.statistics.saves.fortitude}}</strong></div>
            <div><span>{{localize "NPCFORGE.Stats.Reflex"}}</span><strong>{{view.statistics.saves.reflex}}</strong></div>
            <div><span>{{localize "NPCFORGE.Stats.Will"}}</span><strong>{{view.statistics.saves.will}}</strong></div>
          </div>
        </div>
      </details>

      <details class="npc-forge-card" open>
        <summary>{{localize "NPCFORGE.Sections.Attributes"}}</summary>
        <div class="npc-forge-card-body npc-forge-compact-grid six">
          <div><span>{{localize "NPCFORGE.Attributes.STR"}}</span><strong>{{view.statistics.attributes.str}}</strong></div>
          <div><span>{{localize "NPCFORGE.Attributes.DEX"}}</span><strong>{{view.statistics.attributes.dex}}</strong></div>
          <div><span>{{localize "NPCFORGE.Attributes.CON"}}</span><strong>{{view.statistics.attributes.con}}</strong></div>
          <div><span>{{localize "NPCFORGE.Attributes.INT"}}</span><strong>{{view.statistics.attributes.int}}</strong></div>
          <div><span>{{localize "NPCFORGE.Attributes.WIS"}}</span><strong>{{view.statistics.attributes.wis}}</strong></div>
          <div><span>{{localize "NPCFORGE.Attributes.CHA"}}</span><strong>{{view.statistics.attributes.cha}}</strong></div>
        </div>
      </details>

      <details class="npc-forge-card" open>
        <summary>{{localize "NPCFORGE.Fields.Skills"}}</summary>
        <div class="npc-forge-card-body npc-forge-list-grid">
          {{#each view.skills}}<div class="npc-forge-row"><span>{{displayName}}</span><strong>{{displayModifier}}</strong></div>{{/each}}
        </div>
      </details>

      <details class="npc-forge-card" open>
        <summary>{{localize "NPCFORGE.Fields.Attacks"}}</summary>
        <div class="npc-forge-card-body npc-forge-attack-list">
          {{#each view.attacks}}
            <div class="npc-forge-attack">
              <div class="npc-forge-row"><strong>{{displayName}}</strong><strong>{{displayModifier}}</strong></div>
              <small>{{displayDamage}} {{displayDamageType}}</small>
            </div>
          {{/each}}
        </div>
      </details>

      <div class="npc-forge-preview-actions"><button type="button" data-action="createActor"><i class="fa-solid fa-user-plus"></i> {{localize "NPCFORGE.Controls.CreateActor"}}</button></div>
    {{else}}
      <div class="npc-forge-empty">{{localize "NPCFORGE.App.NoPreview"}}</div>
    {{/if}}
  </section>
</div>
