<div class="npc-forge-shell{{#if embedded}} npc-forge-shell-embedded{{/if}}">
  <form data-npc-forge-request class="npc-forge-controls">
    <div class="npc-forge-controls-scroll">
    <header class="npc-forge-panel-header">
      <h2>{{localize "NPCFORGE.App.CreateHeading"}}</h2>
      <p>{{localize "NPCFORGE.App.CreateText"}}</p>
    </header>

    <details class="npc-forge-section" data-section-id="basics" open>
      <summary>{{localize "NPCFORGE.Sections.Basics"}}</summary>
      <div class="npc-forge-section-body npc-forge-form-grid">
        <label>{{localize "NPCFORGE.Fields.Level"}}<input type="number" name="level" value="{{request.level}}" min="-1" max="24"></label>
        <label>{{localize "NPCFORGE.Fields.Ancestry"}}
          <select name="ancestry">{{#each ancestryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}</select>
        </label>
        <label>{{localize "NPCFORGE.Fields.ClassProfile"}}
          <select name="classProfile">{{#each classOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}</select>
        </label>
        <label>{{localize "NPCFORGE.Fields.Role"}}
          <select name="role">{{#each roleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}</select>
        </label>
        {{#if hasSpecializations}}
        <label>{{localize "NPCFORGE.Fields.ClassSpecialization"}}
          <select name="classSpecialization">
            <option value="">{{localize "NPCFORGE.Fields.Automatic"}}</option>
            {{#each specializationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        {{/if}}
        <label>{{localize "NPCFORGE.Fields.ProfessionCategory"}}
          <select name="professionCategory">
            {{#each professionCategoryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        <label>{{localize "NPCFORGE.Fields.Profession"}}
          <select name="profession">
            <option value="">{{localize "NPCFORGE.Fields.AutomaticWithinCategory"}}</option>
            {{#each professionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        {{#if hasProfessionSpecializations}}
        <label>{{localize "NPCFORGE.Fields.ProfessionSpecialization"}}
          <select name="professionSpecialization">
            <option value="">{{localize "NPCFORGE.Fields.Automatic"}}</option>
            {{#each professionSpecializationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        {{/if}}
      </div>
    </details>

    <details class="npc-forge-section" data-section-id="identity" open>
      <summary>{{localize "NPCFORGE.Sections.Identity"}}</summary>
      <div class="npc-forge-section-body npc-forge-form-grid">
        <label>{{localize "NPCFORGE.Fields.Name"}}<input type="text" name="identityName" value="{{request.identity.name}}" placeholder="{{localize "NPCFORGE.Fields.Automatic"}}"></label>
        <label>{{localize "NPCFORGE.Fields.NamePack"}}
          <select name="identityNamePack">
            <option value="">{{localize "NPCFORGE.Fields.Automatic"}}</option>
            {{#each namePackOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}
          </select>
        </label>
        <label>{{localize "NPCFORGE.Fields.Gender"}}
          <select name="identityGender">{{#each genderOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
        <label>{{localize "NPCFORGE.Fields.Age"}}
          <select name="identityAgeCategory">{{#each ageOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
      </div>
    </details>

    <details class="npc-forge-section" data-section-id="personality">
      <summary>{{localize "NPCFORGE.Sections.Personality"}}</summary>
      <div class="npc-forge-section-body npc-forge-form-grid">
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Personality.Generate"}}</span><input type="checkbox" name="personalityEnabled" {{#if personalityEnabled}}checked{{/if}}></label>
        <label>{{localize "NPCFORGE.Personality.Intensity"}}
          <select name="personalityIntensity">{{#each personalityIntensityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Personality.AllowSecrets"}}</span><input type="checkbox" name="personalityAllowSecrets" {{#if personalityAllowSecrets}}checked{{/if}}></label>
      </div>
    </details>

    <details class="npc-forge-section" data-section-id="background">
      <summary>{{localize "NPCFORGE.Sections.Background"}}</summary>
      <div class="npc-forge-section-body npc-forge-form-grid">
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Background.Generate"}}</span><input type="checkbox" name="backgroundEnabled" {{#if backgroundEnabled}}checked{{/if}}></label>
        <label>{{localize "NPCFORGE.Background.Intensity"}}
          <select name="backgroundIntensity">{{#each backgroundIntensityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Background.GenerateSocialContext"}}</span><input type="checkbox" name="backgroundGenerateSocialContext" {{#if backgroundGenerateSocialContext}}checked{{/if}}></label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Background.GenerateRelationships"}}</span><input type="checkbox" name="backgroundGenerateRelationships" {{#if backgroundGenerateRelationships}}checked{{/if}}></label>
        <label>{{localize "NPCFORGE.Background.RelationshipCount"}}
          <select name="backgroundRelationshipCount">{{#each relationshipCountOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}</option>{{/each}}</select>
        </label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Background.AllowPrivateHooks"}}</span><input type="checkbox" name="backgroundAllowPrivateHooks" {{#if backgroundAllowPrivateHooks}}checked{{/if}}></label>
      </div>
    </details>

    <details class="npc-forge-section" data-section-id="appearance">
      <summary>{{localize "NPCFORGE.Sections.Appearance"}}</summary>
      <div class="npc-forge-section-body npc-forge-form-grid">
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Appearance.Generate"}}</span><input type="checkbox" name="appearanceEnabled" {{#if appearanceEnabled}}checked{{/if}}></label>
        <label>{{localize "NPCFORGE.Appearance.Intensity"}}
          <select name="appearanceIntensity">{{#each appearanceIntensityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Appearance.AllowBodyShape"}}</span><input type="checkbox" name="appearanceAllowBodyShape" {{#if appearanceAllowBodyShape}}checked{{/if}}></label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Appearance.AllowScars"}}</span><input type="checkbox" name="appearanceAllowScars" {{#if appearanceAllowScars}}checked{{/if}}></label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Appearance.AllowAgeFeatures"}}</span><input type="checkbox" name="appearanceAllowAgeFeatures" {{#if appearanceAllowAgeFeatures}}checked{{/if}}></label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Appearance.AllowPosture"}}</span><input type="checkbox" name="appearanceAllowPosture" {{#if appearanceAllowPosture}}checked{{/if}}></label>
      </div>
    </details>
{{#if capabilities.editInventory}}
    <details class="npc-forge-section" data-section-id="equipment">
      <summary>{{localize "NPCFORGE.Sections.Equipment"}}</summary>
      <div class="npc-forge-section-body npc-forge-form-grid">
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Integrations.GenerateEquipment"}}</span><input type="checkbox" name="inventoryEnabled" {{#if inventoryEnabled}}checked{{/if}}></label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.EquipmentProgression.ScaleFundamentalRunes"}}</span><input type="checkbox" name="scaleFundamentalRunes" {{#if scaleFundamentalRunesEnabled}}checked{{/if}}></label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Integrations.PersonalItems"}}</span><input type="checkbox" name="personalItems" {{#if personalItemsEnabled}}checked{{/if}}></label>
        <label class="npc-forge-checkbox-row"><span>{{localize "NPCFORGE.Integrations.PoisonedWeapons"}}</span><input type="checkbox" name="allowPoisonedWeapons" {{#if poisonedWeaponsEnabled}}checked{{/if}}></label>
        <label class="npc-forge-form-grid-wide">{{localize "NPCFORGE.Integrations.PoisonPolicy"}}
          <select name="poisonPolicy">{{#each poisonPolicyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize labelKey}}</option>{{/each}}</select>
        </label>
      </div>
    </details>
    {{/if}}

    <details class="npc-forge-section" data-section-id="integrations">
      <summary>{{localize "NPCFORGE.Sections.Integrations"}}</summary>
      <div class="npc-forge-section-body npc-forge-integration-status-list">
        {{#each integrationRows}}
          <div class="npc-forge-integration-status-row {{stateClass}}">
            <div class="npc-forge-integration-status-main">
              <strong>{{label}}</strong>
              <span class="npc-forge-integration-badge">{{statusLabel}}</span>
            </div>
            {{#if details}}<div class="npc-forge-muted npc-forge-integration-details">{{details}}</div>{{/if}}
          </div>
        {{/each}}
      </div>
    </details>

    </div>
    {{#if showGenerate}}<div class="npc-forge-actions npc-forge-action-bar"><button type="button" data-editor-action="generate"><i class="fa-solid fa-dice"></i> {{localize "NPCFORGE.Controls.Generate"}}</button></div>{{/if}}
  </form>

  <section class="npc-forge-preview">
    <div class="npc-forge-preview-scroll npc-forge-creature-preview">
    {{#if hasPreview}}
      <article class="npc-forge-sheet-card npc-forge-sheet-header">
        <div class="npc-forge-sheet-title">
          <h1>{{view.name}}</h1>
          <p>{{view.identityLine}}</p>
        </div>
        <div class="npc-forge-sheet-level">{{localize "NPCFORGE.Fields.Level"}} {{view.level}}</div>
      </article>


      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Identity"}}</h2>
        <div class="npc-forge-stat-grid npc-forge-stat-grid-defense">
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Fields.Gender"}}</span><strong>{{view.identity.gender}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Fields.Age"}}</span><strong>{{view.identity.ageYears}} · {{view.identity.ageCategory}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Fields.Size"}}</span><strong>{{view.identity.size}}</strong></div>
          <div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Fields.Languages"}}</span><strong>{{#each view.identity.languages}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</strong></div>
          {{#if view.identity.senses.length}}<div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Fields.Senses"}}</span><strong>{{#each view.identity.senses}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</strong></div>{{/if}}
        </div>
      </section>

      {{#if view.identity.appearance}}
      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Appearance"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-appearance-list">
          {{#each view.identity.appearance.traits}}
            <div class="npc-forge-sheet-list-row npc-forge-appearance-row"><span>{{displayCategory}}</span><strong>{{displayName}}</strong></div>
          {{/each}}
        </div>
      </section>
      {{/if}}

      {{#if view.personality}}
      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Personality"}}</h2>
        <div class="npc-forge-personality-grid">
          {{#if view.personality.demeanor}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Personality.Category.Demeanor"}}</span><strong>{{view.personality.demeanor.displayName}}</strong><p>{{view.personality.demeanor.displayDescription}}</p></article>{{/if}}
          {{#if view.personality.motivation}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Personality.Category.Motivation"}}</span><strong>{{view.personality.motivation.displayName}}</strong><p>{{view.personality.motivation.displayDescription}}</p></article>{{/if}}
          {{#if view.personality.traits.length}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Personality.Category.Trait"}}</span><strong>{{#each view.personality.traits}}{{displayName}}{{#unless @last}}, {{/unless}}{{/each}}</strong></article>{{/if}}
          {{#if view.personality.flaw}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Personality.Category.Flaw"}}</span><strong>{{view.personality.flaw.displayName}}</strong><p>{{view.personality.flaw.displayDescription}}</p></article>{{/if}}
          {{#if view.personality.quirk}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Personality.Category.Quirk"}}</span><strong>{{view.personality.quirk.displayName}}</strong><p>{{view.personality.quirk.displayDescription}}</p></article>{{/if}}
          {{#if view.personality.secret}}<article class="npc-forge-personality-tile npc-forge-personality-secret"><span>{{localize "NPCFORGE.Personality.Category.Secret"}}</span><strong>{{view.personality.secret.displayName}}</strong><p>{{view.personality.secret.displayDescription}}</p></article>{{/if}}
        </div>
        <h3 class="npc-forge-subheading">{{localize "NPCFORGE.Personality.RoleplayingKit"}}</h3>
        <div class="npc-forge-sheet-list">
          <div class="npc-forge-sheet-entry"><header><strong>{{localize "NPCFORGE.Personality.FirstImpression"}}</strong></header><p>{{view.personality.roleplaying.firstImpression}}</p></div>
          <div class="npc-forge-sheet-entry"><header><strong>{{localize "NPCFORGE.Personality.InConversation"}}</strong></header><p>{{view.personality.roleplaying.conversation}}</p></div>
          <div class="npc-forge-sheet-entry"><header><strong>{{localize "NPCFORGE.Personality.UnderPressure"}}</strong></header><p>{{view.personality.roleplaying.underPressure}}</p></div>
          <div class="npc-forge-sheet-entry"><header><strong>{{localize "NPCFORGE.Personality.DrivingGoal"}}</strong></header><p>{{view.personality.roleplaying.drivingGoal}}</p></div>
        </div>
      </section>
      {{/if}}

      {{#if view.background}}
      <section class="npc-forge-sheet-section npc-forge-background-section">
        <h2>{{localize "NPCFORGE.Sections.Background"}}</h2>
        {{#if view.background.biography}}
        <div class="npc-forge-personality-grid npc-forge-background-grid">
          {{#if view.background.biography.origin}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Background.Category.Origin"}}</span><strong>{{view.background.biography.origin.displayName}}</strong><p>{{view.background.biography.origin.displayDescription}}</p></article>{{/if}}
          {{#if view.background.biography.formative}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Background.Category.Formative"}}</span><strong>{{view.background.biography.formative.displayName}}</strong><p>{{view.background.biography.formative.displayDescription}}</p></article>{{/if}}
          {{#if view.background.biography.currentSituation}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Background.Category.CurrentSituation"}}</span><strong>{{view.background.biography.currentSituation.displayName}}</strong><p>{{view.background.biography.currentSituation.displayDescription}}</p></article>{{/if}}
          {{#if view.background.biography.currentProblem}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Background.Category.CurrentProblem"}}</span><strong>{{view.background.biography.currentProblem.displayName}}</strong><p>{{view.background.biography.currentProblem.displayDescription}}</p></article>{{/if}}
          {{#if view.background.biography.privateHook}}<article class="npc-forge-personality-tile npc-forge-personality-secret"><span>{{localize "NPCFORGE.Background.Category.PrivateHook"}} · {{localize "NPCFORGE.Background.GMOnly"}}</span><strong>{{view.background.biography.privateHook.displayName}}</strong><p>{{view.background.biography.privateHook.displayDescription}}</p></article>{{/if}}
        </div>
        {{/if}}

        {{#if view.background.socialContext}}
        <h3 class="npc-forge-subheading">{{localize "NPCFORGE.Background.SocialContext"}}</h3>
        <div class="npc-forge-personality-grid npc-forge-social-grid">
          {{#if view.background.socialContext.standing}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Background.Category.Standing"}}</span><strong>{{view.background.socialContext.standing.displayName}}</strong><p>{{view.background.socialContext.standing.displayDescription}}</p></article>{{/if}}
          {{#if view.background.socialContext.communityRole}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Background.Category.CommunityRole"}}</span><strong>{{view.background.socialContext.communityRole.displayName}}</strong><p>{{view.background.socialContext.communityRole.displayDescription}}</p></article>{{/if}}
          {{#if view.background.socialContext.reputation}}<article class="npc-forge-personality-tile"><span>{{localize "NPCFORGE.Background.Category.Reputation"}}</span><strong>{{view.background.socialContext.reputation.displayName}}</strong><p>{{view.background.socialContext.reputation.displayDescription}}</p></article>{{/if}}
        </div>
        {{/if}}

        {{#if view.background.relationships.length}}
        <h3 class="npc-forge-subheading">{{localize "NPCFORGE.Background.Relationships"}}</h3>
        <div class="npc-forge-sheet-list npc-forge-relationship-list">
          {{#each view.background.relationships}}
          <article class="npc-forge-sheet-entry npc-forge-relationship{{#if private}} npc-forge-private-entry{{/if}}">
            <header><strong>{{displayName}}</strong><span class="npc-forge-ability-action">{{displayCategory}}{{#if private}} · {{localize "NPCFORGE.Background.GMOnly"}}{{/if}}</span></header>
            <p>{{displayDescription}}</p>
          </article>
          {{/each}}
        </div>
        {{/if}}
      </section>
      {{/if}}

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Attributes"}}</h2>
        <div class="npc-forge-stat-grid npc-forge-stat-grid-attributes">
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.STR"}}</span><strong>{{view.statistics.attributes.str}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.DEX"}}</span><strong>{{view.statistics.attributes.dex}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.CON"}}</span><strong>{{view.statistics.attributes.con}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.INT"}}</span><strong>{{view.statistics.attributes.int}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.WIS"}}</span><strong>{{view.statistics.attributes.wis}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Attributes.CHA"}}</span><strong>{{view.statistics.attributes.cha}}</strong></div>
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Defenses"}}</h2>
        <div class="npc-forge-stat-grid npc-forge-stat-grid-defense">
          <div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Stats.AC"}}</span><strong>{{view.statistics.ac}}</strong></div>
          <div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Stats.HP"}}</span><strong>{{view.statistics.hp}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Stats.Perception"}}</span><strong>{{view.statistics.perception}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Stats.Fortitude"}}</span><strong>{{view.statistics.saves.fortitude}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Stats.Reflex"}}</span><strong>{{view.statistics.saves.reflex}}</strong></div>
          <div class="npc-forge-stat-tile"><span>{{localize "NPCFORGE.Stats.Will"}}</span><strong>{{view.statistics.saves.will}}</strong></div>
          <div class="npc-forge-stat-tile npc-forge-stat-tile-wide"><span>{{localize "NPCFORGE.Stats.Speed"}}</span><strong>{{view.statistics.speed}} {{localize "NPCFORGE.Units.Feet"}}</strong></div>
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Fields.Skills"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-sheet-list-grid">
          {{#each view.skills}}
            <div class="npc-forge-sheet-list-row"><span>{{displayName}}</span><strong>{{displayModifier}}</strong></div>
          {{/each}}
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Fields.Abilities"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-ability-list">
          {{#each view.abilities}}
            <article class="npc-forge-sheet-entry npc-forge-ability">
              <header><strong>{{displayName}}</strong><span class="npc-forge-ability-action">{{displayAction}}</span></header>
              <p>{{displayDescription}}</p>
            </article>
          {{/each}}
          {{#unless view.abilities.length}}<div class="npc-forge-muted">{{localize "NPCFORGE.App.NoAbilities"}}</div>{{/unless}}
        </div>
      </section>


      {{#if view.spellcasting.length}}
      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Spellcasting"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-spellcasting-list">
          {{#each view.spellcasting}}
            <article class="npc-forge-sheet-entry npc-forge-spellcasting">
              <header><strong>{{displayTradition}} · {{displayMode}}</strong><span>{{localize "NPCFORGE.Spellcasting.DC"}} {{dc}} · {{localize "NPCFORGE.Spellcasting.Attack"}} +{{attack}}</span></header>
              <p class="npc-forge-muted">{{displaySource}}{{#if highestRank}} · {{localize "NPCFORGE.Spellcasting.HighestRank"}} {{highestRank}}{{/if}}{{#if focusPoints}} · {{localize "NPCFORGE.Spellcasting.FocusPoints"}} {{focusPoints}}{{/if}}</p>
              {{#each ranks}}
                <div class="npc-forge-spell-rank"><strong>{{displayRank}}</strong>: {{#each spells}}{{displayName}}{{#unless @last}}, {{/unless}}{{/each}}</div>
              {{/each}}
            </article>
          {{/each}}
        </div>
      </section>
      {{/if}}

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Sections.Equipment"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-inventory-list">
          {{#each view.inventory}}
            <div class="npc-forge-sheet-list-row"><span>{{displayName}}</span><span class="npc-forge-muted">{{displayType}}{{#if displayRunes}} · {{displayRunes}}{{/if}}{{#if quantity}} · ×{{quantity}}{{/if}}</span></div>
          {{/each}}
          {{#unless view.inventory.length}}<div class="npc-forge-muted">{{localize "NPCFORGE.App.NoEquipment"}}</div>{{/unless}}
        </div>
      </section>

      <section class="npc-forge-sheet-section">
        <h2>{{localize "NPCFORGE.Fields.Attacks"}}</h2>
        <div class="npc-forge-sheet-list npc-forge-attack-list">
          {{#each view.attacks}}
            <article class="npc-forge-sheet-entry npc-forge-attack">
              <header><strong>{{displayName}}</strong><strong>{{displayModifier}}</strong></header>
              <p>{{displayDamage}} {{displayDamageType}}</p>
            </article>
          {{/each}}
        </div>
      </section>

    {{else}}
      <div class="npc-forge-empty">{{localize "NPCFORGE.App.NoPreview"}}</div>
    {{/if}}
    </div>
